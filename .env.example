# Connexion Postgres (Neon, Supabase, Vercel Postgres…).
# Sans cette variable, l'app utilise un stockage fichier local (dev uniquement).
#
# Utilisez de préférence l'URL de connexion « pooler » de votre fournisseur :
#   - Neon    : l'URL « Pooled connection » (…-pooler.…)
#   - Supabase: le « Connection pooler », port 6543, mode « Transaction »
#
# Exemples :
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?sslmode=require"
DATABASE_URL=

# URL publique du site (canonical, Open Graph, sitemap).
# Le blog est servi sous ce domaine, à /blog. En production : https://swipelink.fr
NEXT_PUBLIC_SITE_URL="https://swipelink.fr"

# Aperçu de la concurrence Google (SerpApi) — optionnel.
# Clé API pour afficher les 3 premiers résultats Google d'un mot-clé.
# Offre gratuite sur https://serpapi.com (crée un compte, copie ta clé).
SERPAPI_KEY=

# --- Publication vers le site vitrine (swipelink.fr/blog) ---
# À la publication, l'app génère une page HTML au design du site et la pousse
# dans le repo GitHub du site. Sans ces variables, cette synchro est désactivée
# (la publication interne à l'app continue de fonctionner).
#
# Token GitHub « fine-grained » avec la permission « Contents: Read and write »
# sur le repo du site uniquement.
SITE_GITHUB_TOKEN=
# Repo du site au format "owner/nom".
SITE_REPO="coldcall-swipelink/swipelink"
# Branche cible (défaut : main).
SITE_BRANCH="main"
# URL publique de CETTE app (sert les images uploadées via /api/uploads).
# Utilisée pour rendre absolues les URLs d'images dans les pages du site.
APP_PUBLIC_URL="https://seo-swipelink.vercel.app"

# Stockage des images uploadées (Vercel Blob).
# Créez un store Blob dans Vercel → Storage : la variable est ajoutée
# automatiquement. Sans elle, les images sont stockées sur le disque local
# (dev uniquement — ne fonctionne pas en serverless).
BLOB_READ_WRITE_TOKEN=

# --- Protection d'accès (recommandée en production) ---
# Mot de passe du back-office (dashboard, éditeur, API). S'il est défini,
# tout sauf le blog public et les images exige une connexion via /login.
# Sans cette variable, l'app reste entièrement ouverte (comportement d'origine).
CMS_PASSWORD=

# Clé API pour les intégrations (ex. robot de publication d'articles) :
# à envoyer dans l'en-tête "X-Api-Key" sur les routes /api. Indépendante du
# mot de passe pour pouvoir être changée sans déconnecter les humains.
ARTICLES_API_KEY=

# --- Suivi de performance (Google Search Console) ---
# Alimente la page /performance du back-office (clics, impressions, position
# moyenne par article, requêtes principales). Sans ces variables, la page
# affiche un état « non connecté » (le reste de l'app fonctionne normalement).
#
# Mise en place (une fois) :
#  1. Google Cloud Console → crée un projet → active l'API « Google Search Console ».
#  2. Crée un COMPTE DE SERVICE, puis une clé JSON : tu obtiens un client_email
#     et une private_key.
#  3. Dans Search Console (search.google.com/search-console) → Paramètres →
#     Utilisateurs et autorisations → ajoute le client_email en accès « Lecture ».
#  4. Renseigne les variables ci-dessous dans Vercel.
GSC_CLIENT_EMAIL=
# Colle la clé privée entre guillemets ; les \n peuvent rester tels quels.
GSC_PRIVATE_KEY=
# Propriété Search Console : "sc-domain:swipelink.fr" (propriété Domaine)
# ou "https://swipelink.fr/" (propriété Préfixe d'URL).
GSC_SITE_URL="sc-domain:swipelink.fr"
